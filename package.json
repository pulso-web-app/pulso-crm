    "spec:validate": "openspec validate --all --strict --no-interactive",
    "spec:update": "openspec update",
    "check": "npm run docs:check && npm run spec:validate && npm run lint && npm test && npm run build",
    "graph": "nx graph",
    "affected": "nx affected -t lint,test,build"
